    "node": ">=20"
  },
  "scripts": {
    "test": "node bin/relay.mjs selftest"
  },
  "keywords": ["claude-code", "codex", "gemini-cli", "antigravity", "usage-limit", "rate-limit", "failover", "mcp", "agents", "agent-skills"],
